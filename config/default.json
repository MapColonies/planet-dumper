{
  "telemetry": {
    "shared": {
      "serviceName": "planet-dumper"
    },
    "logger": {
      "level": "info",
      "prettyPrint": false
    },
    "tracing": {
      "isEnabled": false,
      "url": "http://localhost:4318/v1/trace"
    }
  },
  "httpClient": {
    "timeout": 1000
  },
  "postgres": {
    "enableSslAuth": false,
    "sslPaths": {
      "ca": "",
      "key": "",
      "cert": ""
    }
  },
  "pgDump": {
    "verbose": false
  },
  "ngDump": {
    "verbose": false
  },
  "osmium": {
    "verbose": false,
    "progress": false
  },
  "s3": {
    "upload": {
      "concurrency": 4,
      "partSize": 5
    }
  },
  "arstotzka": {
    "enabled": false,
    "services": {
      "planetDumperPg": "pgServiceId",
      "planetDumperNg": "ngServiceId"
    },
    "mediator": {
      "timeout": 10000,
      "enableRetryStrategy": false,
      "actiony": {
        "url": "http://actiony.com"
      },
      "locky": {
        "url": "http://locky.com"
      }
    }
  }
}
